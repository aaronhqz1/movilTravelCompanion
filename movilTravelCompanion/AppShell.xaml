<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="movilTravelCompanion.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:movilTravelCompanion.Views"
    Title="movilTravelCompanion"
    FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="False">

    <!--
    Unico ShellContent visible: es la pagina raiz del flujo (Home, siguiendo
    el flujo real de la app original: home -> login -> register -> ... -> dashboard).
    Las demas paginas (Login, Register, RegistrationSuccess, ...) NO se declaran aca:
    se registran como rutas "sueltas" en AppShell.xaml.cs y se navega a ellas
    con Shell.Current.GoToAsync(...), que las apila como si fuera una
    NavigationPage normal (push/pop), en vez de aparecer como tabs.
    -->
    <ShellContent
        ContentTemplate="{DataTemplate views:HomePage}"
        Route="HomePage" />

    <!--
    MenuItem (no FlyoutItem): estas 4 entradas navegan con push relativo
    (Shell.Current.GoToAsync(nameof(Pagina))), el mismo patron que ya usa
    toda la app. Un FlyoutItem real requeriria que cada pagina fuera su
    propio ShellContent con ruta absoluta, lo que chocaria con las rutas
    "sueltas" (Routing.RegisterRoute) que Login/TravelDestination ya usan
    para llegar a estas mismas paginas por push. El Flyout esta deshabilitado
    explicitamente en Home/Login/Register/RegistrationSuccess (ver esas
    paginas), asi que estos items solo son alcanzables con sesion iniciada.
    -->
    <MenuItem Text="Viaje Actual" Command="{Binding GoToDashboardCommand}" />
    <MenuItem Text="Cambiar Destino" Command="{Binding GoToTravelDestinationCommand}" />
    <MenuItem Text="Preferencias" Command="{Binding GoToPreferencesCommand}" />
    <MenuItem Text="Cerrar Sesión" Command="{Binding LogoutCommand}" />

</Shell>
