<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:movilTravelCompanion.ViewModels"
             xmlns:models="clr-namespace:movilTravelCompanion.Core.Models;assembly=movilTravelCompanion.Core"
             xmlns:controls="clr-namespace:movilTravelCompanion.Controls"
             x:Class="movilTravelCompanion.Views.DashboardPage"
             x:DataType="viewmodels:DashboardViewModel"
             Shell.NavBarIsVisible="True"
             Title="Panel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Menú" Clicked="OnMenuClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="20">

            <Label
                Text="{Binding WelcomeMessage}"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <!-- Clima del destino de viaje elegido -->
            <controls:WeatherCardView
                CityText="{Binding DestinationCity}"
                TemperatureText="{Binding DestinationTemperature}"
                DetailsText="{Binding DestinationDetails}"
                ShowDetails="True" />

            <!-- Sugerencias de vestimenta para el clima del destino -->
            <Label Text="Sugerencia de vestimenta" Style="{StaticResource SubHeadline}" />

            <VerticalStackLayout
                Spacing="5"
                RadioButtonGroup.GroupName="DashboardClothingStyle"
                RadioButtonGroup.SelectedValue="{Binding SelectedClothingStyle}">
                <RadioButton Content="Casual" Value="casual" />
                <RadioButton Content="Formal" Value="formal" />
                <RadioButton Content="Deportivo" Value="deportivo" />
            </VerticalStackLayout>

            <Button
                Text="Obtener Recomendación de Vestimenta"
                Command="{Binding GetClothingRecommendationCommand}"
                HorizontalOptions="Fill" />

            <ActivityIndicator
                IsRunning="{Binding IsLoadingClothing}"
                IsVisible="{Binding IsLoadingClothing}" />

            <Label
                Text="{Binding ClothingErrorMessage}"
                TextColor="Red" />

            <Label Text="{Binding ClothingRecommendationText}" />

            <!-- Buscar el clima de otra ciudad (se guarda en el historial) -->
            <Entry
                Placeholder="Buscar clima de otra ciudad"
                Text="{Binding SearchCityQuery}"
                ReturnCommand="{Binding SearchCommand}" />

            <Button
                Text="Buscar"
                Command="{Binding SearchCommand}"
                HorizontalOptions="Fill" />

            <!-- Historial: ultimas 3 busquedas -->
            <Label Text="Historial reciente" Style="{StaticResource SubHeadline}" />

            <CollectionView ItemsSource="{Binding RecentHistory}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryEntry">
                        <Grid Padding="0,10" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding City}" />
                            <Label Grid.Column="1" Text="{Binding Temperature, StringFormat='{0:0.#} °C'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
