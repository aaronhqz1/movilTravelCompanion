<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:movilTravelCompanion.ViewModels"
             x:Class="movilTravelCompanion.Views.PreferencesPage"
             x:DataType="viewmodels:PreferencesViewModel"
             Shell.NavBarIsVisible="True"
             Title="Preferencias">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Menú" Clicked="OnMenuClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="20">

            <Label
                Text="Preferencias"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Label
                Text="{Binding StatusMessage}"
                TextColor="Green" />

            <Label
                Text="Estilo de vestimenta por defecto"
                Style="{StaticResource SubHeadline}" />

            <VerticalStackLayout
                Spacing="5"
                RadioButtonGroup.GroupName="ClothingStyle"
                RadioButtonGroup.SelectedValue="{Binding SelectedClothingStyle}">
                <RadioButton Content="Casual" Value="casual" />
                <RadioButton Content="Formal" Value="formal" />
                <RadioButton Content="Deportivo" Value="deportivo" />
            </VerticalStackLayout>

            <Label
                Text="Sensibilidad al frío/calor"
                Style="{StaticResource SubHeadline}" />

            <VerticalStackLayout
                Spacing="5"
                RadioButtonGroup.GroupName="ColdSensitivity"
                RadioButtonGroup.SelectedValue="{Binding SelectedColdSensitivity}">
                <RadioButton Content="Friolento/a" Value="friolento" />
                <RadioButton Content="Normal" Value="normal" />
                <RadioButton Content="Caluroso/a" Value="caluroso" />
            </VerticalStackLayout>

            <Button
                Text="Guardar"
                Command="{Binding SaveCommand}"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
