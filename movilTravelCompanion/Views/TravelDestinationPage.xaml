<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:movilTravelCompanion.ViewModels"
             x:Class="movilTravelCompanion.Views.TravelDestinationPage"
             x:DataType="viewmodels:TravelDestinationViewModel"
             Title="Destino de Viaje">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="¿A dónde viajás?"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Elegí la ciudad de destino de tu viaje. Vas a ver su clima en el panel principal."
                HorizontalTextAlignment="Center" />

            <Entry
                Placeholder="Ciudad de destino"
                Text="{Binding CityQuery}"
                ReturnCommand="{Binding SearchCommand}" />

            <Button
                Text="Buscar"
                Command="{Binding SearchCommand}"
                HorizontalOptions="Fill" />

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <VerticalStackLayout
                Spacing="10"
                IsVisible="{Binding HasResult}">

                <Label
                    Text="{Binding ResultCity}"
                    Style="{StaticResource SubHeadline}" />

                <Label
                    Text="{Binding ResultTemperature}"
                    HorizontalOptions="Center"
                    FontSize="20" />

                <Button
                    Text="Confirmar destino"
                    Command="{Binding ConfirmCommand}"
                    HorizontalOptions="Fill" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
